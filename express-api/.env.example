# ── Server ──────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_db
DB_USER=movie_login
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Use "require" when connecting to Azure Postgres:
# DB_SSLMODE=require

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ── Flask ML service ─────────────────────────────────────────
FLASK_ML_URL=http://localhost:5000
