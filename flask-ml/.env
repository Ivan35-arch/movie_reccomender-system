# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Model path (inside container or local dev)
# For Docker: place model at flask-ml/model/movie_recommender_model.joblib and
# set MODEL_PATH=/app/flask-ml/model/movie_recommender_model.joblib
MODEL_PATH=/app/flask-ml/model/movie_recommender_model.joblib

# Database configuration
# Prefer setting a single DATABASE_URL like:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or fill the DB_* fields below for local dev (DO NOT commit secrets)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# NOTE: Do NOT commit real credentials. Copy this file to ".env.local" and
# keep your secrets out of version control.
