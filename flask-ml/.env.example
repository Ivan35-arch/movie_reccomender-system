# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-min-32-chars
PORT=5000

# ── ML Model ─────────────────────────────────────────────────
# Path is relative to /app inside the container
MODEL_PATH=model/recommender_model.pkl

# ── PostgreSQL (optional — only if Flask writes to DB) ───────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_db
DB_USER=movie_login
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Use "require" when connecting to Azure Postgres:
# DB_SSLMODE=require
