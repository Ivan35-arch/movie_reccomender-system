# Copy this file to .env and fill in values. Do NOT commit .env with real secrets.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Path to trained model (relative to flask-ml/)
MODEL_PATH=model/recommender_model.pkl

# Option A: Provide a single DATABASE_URL (preferred)
# Example (URL-encode special chars in the password):
# postgres://movie_login:%40hazardkid10@your-server.postgres.database.azure.com:5432/movie_db?sslmode=require
# DATABASE_URL=

# Option B: Provide individual DB_* vars (alternative to DATABASE_URL)
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=movie_db
DB_USER=movie_login
DB_PASSWORD=your_password
DB_SSLMODE=require

# TMDb API key (set in env or CI secrets)
TMDB_API_KEY=
